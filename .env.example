# Copie para .env.local e preencha. Nunca faça commit de valores reais.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase → Connect → Transaction pooler (porta 6543). Só no servidor.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Testes de banco locais: um Postgres com superusuário (o banco fin_test é recriado a cada execução)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Pluggy Dashboard → Applications → sua aplicação. Só no servidor.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Segredo da rotina diária (Vercel envia como "Authorization: Bearer ..."). Gere com: openssl rand -hex 32
CRON_SECRET=
